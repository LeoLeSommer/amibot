# Secrets and per-deployment overrides only. Server and module parameters live
# in settings.yaml; a value there written as ${VAR:-default} can still be
# overridden by setting VAR here. Never put a real key in a committed file.

# Required: the database connection string (never logged).
DATABASE_URL=postgres://amibot:amibot@localhost:5432/amibot

# Optional: the OpenCode Go Console key used by the chat module. Leave empty to
# start the server without chat completions.
OPENCODE_GO_API_KEY=

# Optional: select a different settings file (relative to the working dir).
AMIBOT_SETTINGS_FILE=settings.yaml

# Optional: register the chat module (default true).
AMIBOT_CHAT_ENABLED=true

# Optional overrides for settings.yaml ${VAR:-default} values.
AMIBOT_BIND_ADDR=0.0.0.0:3000
AMIBOT_SERVER_NAME=Amibot
AMIBOT_ALLOWED_ORIGINS=http://localhost:8081
AMIBOT_WEB_DIR=../frontend/dist
RUST_LOG=info
