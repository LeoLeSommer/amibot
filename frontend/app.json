{
  "expo": {
    "name": "Amibot",
    "slug": "amibot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "amibot",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "bundleIdentifier": "app.amibot"
    },
    "android": {
      "package": "app.amibot",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
